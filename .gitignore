# ── Secrets ─────────────────────────────────────────────────────────────
.env

# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
build/
dist/

# ── Run outputs and local caches (regenerable) ──────────────────────────
results/
/data/
checkpoints/
scratch/
archive/
out.txt
*.log

# ── Large binaries ──────────────────────────────────────────────────────
*.pt
*.pth
*.npy
*.mp4
images/videos/

# ── LaTeX build artifacts (keep .tex, .bib, .pdf) ───────────────────────
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.spl
*.abs
*.synctex.gz
*.toc
*.lof
*.lot

# ── Editor / OS ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.$*.drawio.bkp
.$*.drawio.dtmp

# ── AI coding-agent config and internal working notes ───────────────────
# Kept on disk, never published: agent instructions and live research notes
# are private working state, not part of the released artifact.
.claude/
.cursor/
.github/copilot-instructions.md
AGENTS.md
CLAUDE.md
CLAUDE.local.md
NOTES_next.md
.mcp.json

# ── Manuscripts and reference papers ────────────────────────────────────
# Kept on disk, never published: LaTeX sources, bibliography and compiled
# PDFs of the papers, plus third-party PDFs that are not ours to redistribute.
/paper/
/paper.*
/refs.bib
/*.pdf
/reference_Papers/

# ── Source images (local working set) ───────────────────────────────────
images/

/*.ipynb
/*.csv
/*.bat
/*.png
/test_*.py
/inspect_mobilevit.py
/download_*.py
/generate_foundation_nb.py
/run_imagenets_xai.py
/results_test/
*_backup.*

# ── Exception: vector figures are tracked, they are paper/README assets ─
!figures/**/*.pdf
!figures/**/*.tex
!figures/**/*.xml