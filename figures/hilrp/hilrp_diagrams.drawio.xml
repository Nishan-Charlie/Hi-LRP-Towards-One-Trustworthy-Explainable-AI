  <diagram id="unifying" name="Fig3-resolution-reduction">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="p3-0" />
        <mxCell id="p3-1" parent="p3-0" />

        <mxCell id="p3-title" value="One unifying form: every resolution reduction is a linear map on a token neighbourhood" style="text;html=1;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;" vertex="1" parent="p3-1">
          <mxGeometry x="60" y="20" width="1080" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p3-o1" value="&lt;b&gt;Patch merging&lt;/b&gt; (Swin)&#10;concat a 2&#215;2 neighbourhood,&#10;then project" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#226E32;fontSize=13;align=center;" vertex="1" parent="p3-1">
          <mxGeometry x="60" y="110" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3-o2" value="&lt;b&gt;Strided patch embed&lt;/b&gt; (conv stem)&#10;linear map on a pixel&#10;neighbourhood" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#226E32;fontSize=13;align=center;" vertex="1" parent="p3-1">
          <mxGeometry x="60" y="215" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3-o3" value="&lt;b&gt;Spatial reduction&lt;/b&gt; (PVT, EfficientViT)&#10;strided conv on the token grid&#10;(K/V downsampling)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#226E32;fontSize=13;align=center;" vertex="1" parent="p3-1">
          <mxGeometry x="60" y="320" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="p3-form" value="&lt;b&gt;T(N) = W &#966;( concat(x&lt;sup&gt;(1)&lt;/sup&gt;, &#8230;, x&lt;sup&gt;(n)&lt;/sup&gt;) )&lt;/b&gt;&#10;&#10;concat = coordinate embedding&#10;&#966; = conservation-preserving normalisation&#10;W = linear projection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F4E91;fontSize=14;align=center;" vertex="1" parent="p3-1">
          <mxGeometry x="410" y="180" width="330" height="150" as="geometry" />
        </mxCell>

        <mxCell id="p3-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=blockThin;endFill=1;" edge="1" parent="p3-1" source="p3-o1" target="p3-form"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=blockThin;endFill=1;" edge="1" parent="p3-1" source="p3-o2" target="p3-form"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=blockThin;endFill=1;" edge="1" parent="p3-1" source="p3-o3" target="p3-form"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="p3-rule" value="&lt;b&gt;One &#949;-rule&lt;/b&gt;&#10;&#10;R(v&#8323;) = &#8721;&#7522; ( z&#7522;&#8323; / z&#7522; ) R(y&#7522;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#C0600A;fontSize=14;align=center;" vertex="1" parent="p3-1">
          <mxGeometry x="850" y="180" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-e4" value="Lemma 1&#10;(sum exchange)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=12;" edge="1" parent="p3-1" source="p3-form" target="p3-rule"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="p3-cons" value="&lt;b&gt;Conserves:&lt;/b&gt;  &#8721;&#8323; R(v&#8323;) = &#8721;&#7522; R(y&#7522;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#226E32;fontSize=14;align=center;fontStyle=1" vertex="1" parent="p3-1">
          <mxGeometry x="850" y="310" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B0141E;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="p3-1" source="p3-rule" target="p3-cons"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="p3-l2" value="&lt;b&gt;Lemma 2 (free operations).&lt;/b&gt; When exactly one contribution z&#7522;&#8323; is non-zero per output, the ratio is 1 and the rule is exact with no leakage. This covers the coordinate embedding (concat), window partitioning, and the cyclic shift: they are permutations, so they need no new rule and lose no relevance. Verified: patch merge 3&#215;10&#8315;&#185;&#8310;, shifted-window mask leak ~10&#8315;&#8308;&#179; (structurally zero)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" vertex="1" parent="p3-1">
          <mxGeometry x="60" y="440" width="1060" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3-cor" value="&lt;b&gt;Corollaries, not new derivations:&lt;/b&gt;  patch merging &#183; strided patch embedding &#183; spatial reduction &#8594; each is an instance of T(N), so each inherits the proof." style="text;html=1;align=center;fontSize=13;fontStyle=2;fontColor=#555555;" vertex="1" parent="p3-1">
          <mxGeometry x="60" y="540" width="1060" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

